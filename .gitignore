# ==============================================================================
# Git Ignore for Spark ERP (School Management Portal)
# ==============================================================================

# Node dependencies
node_modules/
*/node_modules/

# Production build artifacts
dist/
build/
*/dist/
*/build/

# Sensitive environment files and credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example
config.env
*/config.env
serviceAccountKey.json
*/serviceAccountKey.json
config/serviceAccountKey.json
backend/config/serviceAccountKey.json

# Local and test uploads (preserve directory structure via .gitkeep)
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/uploads/documents/*
!backend/uploads/documents/.gitkeep
backend/uploads/photos/*
!backend/uploads/photos/.gitkeep
backend/uploads/school-logos/*
!backend/uploads/school-logos/.gitkeep

# Temporary and log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
*.tmp
network-all.txt

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
