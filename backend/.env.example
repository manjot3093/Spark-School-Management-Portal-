# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/erp)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/erp?retryWrites=true&w=majority

# JWT Authentication
# Random secret string (min 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1200

# Security
BCRYPT_ROUNDS=12

# Cloudinary Storage (Image & File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Test / Live Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# vLLM / AI Model Configuration (Optional)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your_vllm_api_key
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_TIMEOUT_S=120
